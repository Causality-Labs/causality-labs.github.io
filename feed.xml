</pre></td><td class="code"><pre><span class="o">&amp;</span><span class="n">i2c0</span> <span class="p">{</span>
	<span class="n">status</span> <span class="o">=</span> <span class="s">"okay"</span><span class="p">;</span>
	<span class="n">clock</span><span class="o">-</span><span class="n">frequency</span> <span class="o">=</span> <span class="o">&lt;</span><span class="n">I2C_BITRATE_FAST</span><span class="o">&gt;</span><span class="p">;</span>
	<span class="n">pinctrl</span><span class="o">-</span><span class="mi">0</span> <span class="o">=</span> <span class="o">&lt;&amp;</span><span class="n">i2c0_default</span><span class="o">&gt;</span><span class="p">;</span>
	<span class="n">pinctrl</span><span class="o">-</span><span class="mi">1</span> <span class="o">=</span> <span class="o">&lt;&amp;</span><span class="n">i2c0_sleep</span><span class="o">&gt;</span><span class="p">;</span>
	<span class="n">pinctrl</span><span class="o">-</span><span class="n">names</span> <span class="o">=</span> <span class="s">"default"</span><span class="p">,</span> <span class="s">"sleep"</span><span class="p">;</span>

	<span class="nl">bme280_0:</span> <span class="n">bme280</span><span class="err">@</span><span class="mi">76</span> <span class="p">{</span>
		<span class="n">compatible</span> <span class="o">=</span> <span class="s">"bosch,bme280"</span><span class="p">;</span>
