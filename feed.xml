	<span class="p">};</span>

	<span class="nl">sgp40_0:</span> <span class="n">sgp40</span><span class="err">@</span><span class="mi">59</span> <span class="p">{</span>
		<span class="n">compatible</span> <span class="o">=</span> <span class="s">"sensirion,sgp40"</span><span class="p">;</span>
		<span class="n">status</span> <span class="o">=</span> <span class="s">"okay"</span><span class="p">;</span>
		<span class="n">reg</span> <span class="o">=</span> <span class="o">&lt;</span><span class="mh">0x59</span><span class="o">&gt;</span><span class="p">;</span>
