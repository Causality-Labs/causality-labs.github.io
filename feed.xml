	<span class="nl">scd40_0:</span> <span class="n">scd40</span><span class="err">@</span><span class="mi">62</span> <span class="p">{</span>
		<span class="n">compatible</span> <span class="o">=</span> <span class="s">"sensirion,scd40"</span><span class="p">;</span>
		<span class="n">status</span> <span class="o">=</span> <span class="s">"okay"</span><span class="p">;</span>
		<span class="n">reg</span> <span class="o">=</span> <span class="o">&lt;</span><span class="mh">0x62</span><span class="o">&gt;</span><span class="p">;</span>
	<span class="p">};</span>
<span class="p">};</span>

<span class="o">&amp;</span><span class="n">pinctrl</span> <span class="p">{</span>
	<span class="o">/</span><span class="n">omit</span><span class="o">-</span><span class="k">if</span><span class="o">-</span><span class="n">no</span><span class="o">-</span><span class="n">ref</span><span class="o">/</span> <span class="n">i2c0_default</span><span class="o">:</span> <span class="n">i2c0_default</span> <span class="p">{</span>
